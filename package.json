{
  "name": "@marie-christ/maketou",
  "version": "0.0.0",
  "description": "Community-maintained TypeScript SDK for the Maketou API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariechristsagbo/maketou-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/mariechristsagbo/maketou-typescript/issues"
  },
  "homepage": "https://github.com/mariechristsagbo/maketou-typescript#readme",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.5.1",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "zod": "^4.6.4"
  }
}
